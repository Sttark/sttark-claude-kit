---
// The empty state of every page until the person links a Mac: what the page
// will show, and how to link one, in the Kit's own words (its menu, its
// window's Settings, the Phone box).
import { ICONS } from '../lib/icons.ts';
interface Props {
  /** What this page shows once a Mac is linked. */
  lead: string;
}
---
<section class="empty" aria-labelledby="no-mac">
  <h2 id="no-mac"><Fragment set:html={ICONS.laptop} />No Mac linked yet</h2>
  <p class="lede">{Astro.props.lead}</p>
  <p class="steps-h">To link your Mac:</p>
  <ol class="steps">
    <li>On your Mac, click the Kit's gauge in the menu bar, then <b>Open Sttark Claude Kit</b>.</li>
    <li>Click <b>Settings</b>, then <b>Link this Mac</b> in the <b>Phone</b> box.</li>
    <li>Sign in with your Sttark Google account, then click <b>Link</b>.</li>
  </ol>
</section>
