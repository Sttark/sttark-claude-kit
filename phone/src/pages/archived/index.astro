---
// Archived: the archived sessions each linked Mac lists, newest first,
// grouped by day. The top bar's Search (on Sessions) finds them with every
// other session. Until a Mac is linked, how to link one.
import Base from '../../layouts/Base.astro';
import { loadKit } from '../../lib/state.ts';
import { draw, type View } from '../../view/render.ts';
import { emptyUi } from '../../view/model.ts';
const kit = loadKit(Astro.locals.user!);
const view: View = { page: 'archived' };
const drawn = draw(view, kit, emptyUi());
---
<Base title={drawn.title} drawn={drawn} kit={kit} view={view} />
