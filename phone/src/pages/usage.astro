---
// Usage: the 5-hour and weekly limits with their resets and the 60% and
// 80% marks, the sessions held at them, and the Use credits setting. Until
// a Mac is linked, how to link one.
import Base from '../layouts/Base.astro';
import { loadKit } from '../lib/state.ts';
import { draw, type View } from '../view/render.ts';
import { emptyUi } from '../view/model.ts';
const kit = loadKit(Astro.locals.user!);
const view: View = { page: 'usage' };
const drawn = draw(view, kit, emptyUi());
---
<Base title={drawn.title} drawn={drawn} kit={kit} view={view} />
