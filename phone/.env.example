# Local runs only: npm run dev reads .env into the environment (production
# gets its environment from the server's env file). Never a real secret here.
#
# Act as this made-up person without signing in. Ignored when NODE_ENV is
# production, which `node server.mjs` sets unless told otherwise.
DEV_FAKE_USER=avery.stone@sttark.com
# The database file (made, with its folder, on first start).
KIT_DB=data/kit.db
# The public origin; Google sends people back to APP_ORIGIN/auth/callback.
APP_ORIGIN=http://localhost:4350
# The shared Sttark Workspace sign-in client. Unset, Sign in with Google says
# it is not set up.
VAULT_GOOGLE_CLIENT_ID=
VAULT_GOOGLE_CLIENT_SECRET=
# The Kit's own read-only Workrouter org-sync key (sk_org_...). Unset, the
# roster stays as stored, so on a new database nobody can sign in with Google.
VAULT_ORG_SYNC_TOKEN=
